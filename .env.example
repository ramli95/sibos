# Salin menjadi .env.local untuk menjalankan di komputer sendiri.
# Di GitHub, nilai yang sama diisi di Settings → Secrets and variables → Actions → Variables.
# Kunci Firebase web memang publik; keamanan data dijaga oleh firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# URL Web App Apps Script penghubung Google Drive (diisi setelah penghubung dipasang)
VITE_PENGHUBUNG_DRIVE_URL=
