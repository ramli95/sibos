rules_version = '2';
// ================================================================
//  Aturan akses Firestore SIBOS — Fase 8 (Rekonsiliasi ARKAS–SIMAKDA–Bank, pengingat, arsip PDF ke Drive)
//  Peran di pengguna/{uid}.peran: bendahara, tim_bos, kepala_sekolah, komite, pengurus_barang
//  Prinsip: hanya Bendahara (Admin) yang mengubah data; data sensitif pegawai hanya untuk Bendahara.
//  Kecuali Barang & Aset: Bendahara dan Pengurus Barang boleh mencatat inventaris, ruangan, dan persediaan.
//  Data gaji (dasar gaji, daftar gaji, SKPG, KGB) hanya untuk Bendahara — Kepala Sekolah pun tidak membaca.
//  Peralihan bendahara: Bendahara aktif, atau Kepala Sekolah bila bendahara berhalangan.
//  Fase 7: publik/bos bisa dibaca tanpa login (hanya angka ringkasan yang diterbitkan Bendahara);
//  catatan pribadi bendahara hanya bisa dibaca & diubah oleh pemilik akunnya sendiri.
// ================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- fungsi bantu ----------
    function masuk() { return request.auth != null; }
    function profil() { return get(/databases/$(database)/documents/pengguna/$(request.auth.uid)).data; }
    function aktif() { return masuk() && exists(/databases/$(database)/documents/pengguna/$(request.auth.uid)) && profil().aktif == true; }
    function punya(p) { return aktif() && p in profil().peran; }
    function admin() { return punya('bendahara'); }
    function kepsek() { return punya('kepala_sekolah'); }
    function salahSatu(daftar) { return aktif() && profil().peran.hasAny(daftar); }
    function barang() { return salahSatu(['bendahara', 'pengurus_barang']); }
    function hanyaUbah(kolom) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(kolom); }

    // Penyiapan Awal: hanya email pemilik pertama, hanya sekali, dan semua dalam satu batch
    // bersama pembuatan sistem/penyiapan.
    function penyiapanAwal() {
      return masuk()
        && request.auth.token.email == 'ramli51@guru.sma.belajar.id'
        && !exists(/databases/$(database)/documents/sistem/penyiapan)
        && existsAfter(/databases/$(database)/documents/sistem/penyiapan);
    }

    // ---------- sistem ----------
    match /sistem/penyiapan {
      allow read: if masuk();
      allow create: if masuk()
        && request.auth.token.email == 'ramli51@guru.sma.belajar.id'
        && !exists(/databases/$(database)/documents/sistem/penyiapan);
      allow update, delete: if false;   // terkunci selamanya
    }
    match /sistem/pemilik {
      allow read: if aktif();
      allow create: if penyiapanAwal();
      allow update: if admin() || kepsek();   // serah terima bendahara
      allow delete: if false;
    }
    match /sistem/{id} {
      allow read: if aktif();
      allow create: if id != 'penyiapan' && id != 'pemilik' && (penyiapanAwal() || admin());
      allow update: if id != 'penyiapan' && id != 'pemilik' && admin();
      allow delete: if false;
    }

    // ---------- akun ----------
    // Pemetaan username → email untuk login. Hanya bisa dibaca per username (tidak bisa didaftar).
    match /akun_login/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if penyiapanAwal() || admin();
      allow update, delete: if admin();
    }

    match /pengguna/{uid} {
      allow get: if (masuk() && request.auth.uid == uid) || admin() || kepsek();
      allow list: if admin() || kepsek();
      allow create: if (penyiapanAwal() && request.auth.uid == uid) || admin();
      // Pengguna sendiri: hanya penanda ganti password, tema, pengaturan & token notifikasi
      allow update: if masuk() && request.auth.uid == uid
        && hanyaUbah(['wajib_ganti_password', 'password_diubah', 'tema', 'pengaturan_notifikasi', 'token_fcm'])
        && request.resource.data.get('wajib_ganti_password', false) == false;
      allow update: if admin();
      // Kepala Sekolah: boleh mengalihkan peran & status aktif (serah terima darurat)
      allow update: if kepsek() && hanyaUbah(['peran', 'aktif', 'diubah', 'diubah_oleh']);
      allow delete: if false;   // akun tidak dihapus, cukup dinonaktifkan
    }

    match /serah_terima/{id} {
      allow read: if admin() || kepsek();
      allow create: if (admin() || kepsek()) && request.resource.data.oleh == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------- pengaturan ----------
    match /sekolah/{id} {
      allow read: if aktif();
      allow create: if penyiapanAwal() || admin();
      allow update: if admin();
      allow delete: if false;
    }

    // Pejabat penanda tangan per periode
    match /pejabat/{id} {
      allow read: if aktif();
      allow create: if penyiapanAwal() || admin()
        || (kepsek() && request.resource.data.jabatan in ['bendahara_bosp', 'bendahara_gaji']);
      allow update: if admin()
        || (kepsek() && resource.data.jabatan in ['bendahara_bosp', 'bendahara_gaji'] && hanyaUbah(['sampai', 'diubah']));
      allow delete: if admin();
    }

    // ---------- master data ----------
    // Pegawai: data umum untuk Tim BOS & Kepala Sekolah; data sensitif di subkoleksi rahasia
    match /pegawai/{id} {
      allow read: if salahSatu(['bendahara', 'tim_bos', 'kepala_sekolah']);
      allow write: if admin();
      // NIK, NPWP pribadi, rekening, status keluarga, gaji → hanya Bendahara
      match /rahasia/{doc} {
        allow read, write: if admin();
      }
    }

    match /rekanan/{id} {
      allow read: if aktif();
      allow write: if admin();
    }

    match /referensi/{jenis}/{rest=**} {
      allow read: if aktif();
      allow write: if admin();
    }

    // ---------- perencanaan (Fase 2) ----------
    // RKAS per versi (murni/pergeseran/perubahan) + uraian per SNP. Semua peran melihat; hanya Bendahara mengubah.
    match /rkas/{versi} {
      allow read: if aktif();
      allow write: if admin();
      match /bagian/{snp} {
        allow read: if aktif();
        allow write: if admin();
      }
    }
    // Catatan pergeseran: hanya ditambah, tidak diubah/dihapus
    match /rkas_pergeseran/{id} {
      allow read: if aktif();
      allow create: if admin() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    match /standar_harga/{id} {
      allow read: if aktif();
      allow write: if admin();
    }
    // SSH pemerintah yang disimpan/diubah sekolah (isi dipotong 1.000 item per dokumen)
    match /ssh/{sumber} {
      allow read: if aktif();
      allow write: if admin();
      match /potong/{n} {
        allow read: if aktif();
        allow write: if admin();
      }
    }

    // ---------- belanja & dokumen SPJ (Fase 3) ----------
    // Transaksi belanja/honor + foto dokumentasi versi cetak. Semua peran melihat; hanya Bendahara mengubah.
    match /belanja/{id} {
      allow read: if aktif();
      allow write: if admin();
      match /foto/{idFoto} {
        allow read: if aktif();
        allow write: if admin();
      }
    }
    // Penghitung nomor surat/kwitansi/invoice per tahun: tidak pernah dihapus agar nomor tidak dipakai ulang
    match /penomoran/{id} {
      allow read: if aktif();
      allow create, update: if admin();
      allow delete: if false;
    }
    // Buku agenda surat (nomor dari belanja & surat manual)
    match /agenda_surat/{id} {
      allow read: if aktif();
      allow write: if admin();
    }
    // Penerima honor/transpor dari luar sekolah (narasumber, pengawas, juri)
    match /orang_luar/{id} {
      allow read: if salahSatu(['bendahara', 'tim_bos', 'kepala_sekolah']);
      allow write: if admin();
    }

    // ---------- pajak & buku kas (Fase 4) ----------
    // Tarif pajak ada di referensi/aturan_pajak (aturan referensi di atas: semua melihat, Bendahara mengubah).
    // Setoran pajak: satu kode billing/NTPN untuk satu atau beberapa kewajiban pajak
    match /setoran_pajak/{id} {
      allow read: if aktif();
      allow write: if admin();
    }
    // Baris buku kas manual: penerimaan dana, bunga, pajak bunga, tarik/setor tunai, koreksi
    match /kas/{id} {
      allow read: if aktif();
      allow write: if admin();
    }
    // Tutup buku bulanan (tanpa kunci periode: Bendahara boleh membuka kembali; tidak dihapus)
    match /tutup_buku/{id} {
      allow read: if aktif();
      allow create, update: if admin();
      allow delete: if false;
    }
    // Rekening koran hasil impor + pasangan mutasi
    match /rekening_koran/{id} {
      allow read: if salahSatu(['bendahara', 'kepala_sekolah', 'tim_bos']);
      allow write: if admin();
    }

    // ---------- barang & aset (Fase 5) ----------
    // Inventaris (KIB & ekstrakomptabel), ruangan, mutasi persediaan, dan kelas barang hasil belanja
    match /aset/{id} {
      allow read: if aktif();
      allow write: if barang();
    }
    match /aset_ruang/{id} {
      allow read: if aktif();
      allow write: if barang();
    }
    match /persediaan/{id} {
      allow read: if aktif();
      allow write: if barang();
    }
    match /barang_kelas/{tahun} {
      allow read: if aktif();
      allow write: if barang();
    }
    // BAST Bendahara → Pengurus Barang: bernomor surat sekolah, hanya Bendahara
    match /bast_barang/{id} {
      allow read: if aktif();
      allow write: if admin();
    }

    // ---------- kepegawaian & gaji (Fase 6) ----------
    // Dasar gaji per pegawai (MKG, gaji pokok, tunjangan & potongan tetap)
    match /gaji_dasar/{id} {
      allow read, write: if admin();
    }
    // Per bulan (yyyy-mm): Daftar Gaji resmi hasil impor PDF + Daftar Gaji SIBOS yang disimpan
    match /gaji/{periode} {
      allow read, write: if admin();
    }
    // KGB: surat pengantar usulan & SK/pemberitahuan yang terbit
    match /kgb/{id} {
      allow read, write: if admin();
    }
    // SKPG yang sudah diterbitkan (nomor surat, bulan, keperluan, angka)
    match /skpg/{id} {
      allow read, write: if admin();
    }

    // ---------- papan informasi, serah terima, WhatsApp, catatan (Fase 7) ----------
    // Halaman publik tanpa login: satu dokumen ringkasan yang diterbitkan Bendahara
    match /publik/{id} {
      allow get: if true;
      allow list: if false;
      allow write: if admin();
    }
    // Berita Acara serah terima bendahara (Bendahara, atau Kepala Sekolah bila bendahara berhalangan)
    match /ba_serah_terima/{id} {
      allow read, write: if admin() || kepsek();
    }
    // Template & riwayat pesan WhatsApp (nomor pegawai/rekanan) — hanya Bendahara
    match /template_wa/{id} {
      allow read, write: if admin();
    }
    match /pesan_wa/{id} {
      allow read, write: if admin();
    }
    // Catatan kas sekolah di luar Dana BOSP: Kepala Sekolah ikut melihat
    match /catatan_kas_sekolah/{id} {
      allow read: if admin() || kepsek();
      allow write: if admin();
    }
    // Catatan pribadi bendahara: hanya pemilik catatan (uid sama), tidak terbaca bendahara berikutnya
    match /catatan_pribadi/{id} {
      allow read, delete: if admin() && resource.data.uid == request.auth.uid;
      allow create: if admin() && request.resource.data.uid == request.auth.uid;
      allow update: if admin() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
    }

    // ---------- Kas Lain & Iuran (di luar Dana BOSP) ----------
    // Pos kas, buku kas per pos, tagihan per orang + setoran, utang piutang. Kepala Sekolah ikut melihat.
    match /kas_lain_pos/{id} {
      allow read: if admin() || kepsek();
      allow write: if admin();
    }
    match /kas_lain_transaksi/{id} {
      allow read: if admin() || kepsek();
      allow write: if admin();
    }
    match /kas_lain_tagihan/{id} {
      allow read: if admin() || kepsek();
      allow write: if admin();
    }
    match /utang_piutang/{id} {
      allow read: if admin() || kepsek();
      allow write: if admin();
    }

    // ---------- rekonsiliasi (Fase 8) ----------
    // Saldo akhir bulan menurut ARKAS & SIMAKDA yang dicatat Bendahara untuk dicocokkan dengan BKU SIBOS
    match /rekonsiliasi/{id} {
      allow read: if salahSatu(['bendahara', 'kepala_sekolah', 'tim_bos']);
      allow write: if admin();
    }

    // ---------- notifikasi, log, impor ----------
    match /notifikasi/{id} {
      allow read: if masuk() && resource.data.uid == request.auth.uid;
      allow update: if masuk() && resource.data.uid == request.auth.uid && hanyaUbah(['dibaca']);
      allow create, delete: if admin();
    }

    // Log aktivitas: hanya bisa ditambah oleh pelakunya sendiri; tidak bisa diubah/dihapus
    match /log_aktivitas/{id} {
      allow create: if masuk() && request.resource.data.uid == request.auth.uid;
      allow read: if salahSatu(['bendahara', 'kepala_sekolah']);
      allow update, delete: if false;
    }

    match /pemetaan_impor/{id} {
      allow read, write: if admin();
    }

    // Selain yang disebut di atas: tertutup
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
